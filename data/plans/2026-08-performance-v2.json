  "assumptions": [
    "O desconforto leve na virilha e o histórico antigo de pubalgia são contexto de carga, não diagnóstico.",
    "O dia exato do jogo no fim de semana continua desconhecido.",
    "Há uma barra de 7 kg, 60 kg em anilhas, barra fixa, barras paralelas e caixa estável.",
    "Não há elástico ou polia confirmados; por isso o plano ativo não depende desses equipamentos."
  ],
  "global_rules": {
    "lower_body_reps_in_reserve": "2-3",
    "upper_body_reps_in_reserve": "1-2",
    "lower_body_training_to_failure": false,
    "handstand_training_to_failure": false,
    "jump_quality_rule": "Interromper a série se altura, velocidade, aterrissagem ou coordenação piorarem claramente.",
    "progression_rule": "Ao completar o topo da faixa em todas as séries com o RIR alvo e boa técnica, adicionar o menor incremento prático de carga.",
    "single_variable_progression_rule": "Não aumentar carga, séries e dificuldade do exercício na mesma semana.",
    "introductory_rule": "Usar uma exposição semanal para a marcha de flexores do quadril nas duas primeiras semanas; passar a duas somente sem piora durante ou no dia seguinte.",
    "groin_rule": "Não progredir Copenhagen, marcha de flexores ou amplitude lateral quando houver aumento do desconforto durante ou após a sessão.",
    "deload_rule": "Reduzir o volume de força em 30-40% após 4-6 semanas ou antes quando marcadores de fadiga se acumularem."
  },
