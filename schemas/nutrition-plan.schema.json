{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/nutrition-plan.schema.json",
  "title": "Versioned personal nutrition plan",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "version",
    "lifecycle_status",
    "professional_status",
    "created_at",
    "last_updated",
    "effective_from",
    "effective_until",
    "timezone",
    "approval",
    "provenance",
    "use_policy",
    "energy_bands",
    "day_types",
    "timing_rules",
    "meals",
    "carbohydrate_modules",
    "food_preferences",
    "excluded_from_foundation",
    "unknowns"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "plan_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "version": { "type": "string", "minLength": 1 },
    "lifecycle_status": {
      "enum": ["draft", "approved_for_personal_use", "archived"]
    },
    "professional_status": {
      "enum": ["not_validated", "validated"]
    },
    "created_at": { "type": "string", "format": "date" },
    "last_updated": { "type": "string", "format": "date" },
    "effective_from": { "type": "string", "format": "date" },
    "effective_until": {
      "oneOf": [
        { "type": "string", "format": "date" },
        { "type": "null" }
      ]
    },
    "timezone": { "type": "string", "minLength": 1 },
    "approval": {
      "type": "object",
      "required": ["actor", "approved_at", "scope"],
      "properties": {
        "actor": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date" },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_repository",
        "source_snapshot_commit",
        "source_artifact_ids",
        "transformation",
        "active_training_plan_id"
      ],
      "properties": {
        "source_repository": { "type": "string", "minLength": 1 },
        "source_snapshot_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "source_review_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "source_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "transformation": { "type": "string", "minLength": 1 },
        "active_training_plan_id": { "type": "string", "pattern": "^[a-z0-9_]+$" }
      },
      "additionalProperties": true
    },
    "use_policy": {
      "type": "object",
      "required": [
        "purpose",
        "not_a_clinical_prescription",
        "no_automatic_recommendation",
        "change_rule",
        "safety_rule"
      ],
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "not_a_clinical_prescription": { "const": true },
        "no_automatic_recommendation": { "type": "boolean" },
        "no_continuous_calorie_counting": { "type": "boolean" },
        "change_rule": { "type": "string", "minLength": 1 },
        "safety_rule": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "energy_bands": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/energyBand" }
    },
    "day_types": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dayType" }
    },
    "timing_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/timingRule" }
    },
    "meals": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/meal" }
    },
    "carbohydrate_modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/carbohydrateModule" }
    },
    "food_preferences": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "excluded_from_foundation": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "unknowns": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "nullableText": {
      "oneOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "foodItem": {
      "type": "object",
      "required": ["food", "quantity", "unit"],
      "properties": {
        "food": { "type": "string", "minLength": 1 },
        "quantity": { "$ref": "#/$defs/nullableText" },
        "unit": { "$ref": "#/$defs/nullableText" },
        "optional": { "type": "boolean" },
        "quantity_basis": { "type": "string" },
        "alternatives": {
          "type": "array",
          "items": { "$ref": "#/$defs/foodItem" }
        }
      },
      "additionalProperties": true
    },
    "mealOption": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 },
        "use_when": { "type": "string" },
        "follow_up_rule": { "type": "string" },
        "reference_option": {
          "type": "string",
          "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/foodItem" }
        },
        "unknowns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "anyOf": [
        { "required": ["items"] },
        { "required": ["reference_option"] }
      ],
      "additionalProperties": true
    },
    "meal": {
      "type": "object",
      "required": ["id", "label", "default_time", "required", "options"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 },
        "default_time": {
          "oneOf": [
            { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
            { "type": "null" }
          ]
        },
        "required": { "type": "boolean" },
        "use_when": { "type": "string" },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mealOption" }
        }
      },
      "additionalProperties": true
    },
    "energyBand": {
      "type": "object",
      "required": ["minimum_kcal", "maximum_kcal", "status"],
      "properties": {
        "minimum_kcal": { "type": "integer", "minimum": 0 },
        "maximum_kcal": { "type": "integer", "minimum": 0 },
        "status": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "dayType": {
      "type": "object",
      "required": [
        "id",
        "label",
        "energy_band_id",
        "carbohydrate_modules",
        "meal_rule",
        "meal_ids"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 },
        "energy_band_id": { "$ref": "#/$defs/identifier" },
        "carbohydrate_modules": {
          "type": "object",
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": { "type": "integer", "minimum": 0 },
            "maximum": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "meal_rule": { "type": "string", "minLength": 1 },
        "meal_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "timingRule": {
      "type": "object",
      "required": ["id", "condition", "meal_id", "start_time", "end_time", "option_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "condition": { "type": "string", "minLength": 1 },
        "meal_id": { "$ref": "#/$defs/identifier" },
        "start_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end_time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "option_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "carbohydrateModule": {
      "type": "object",
      "required": ["id", "label", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/foodItem" }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
